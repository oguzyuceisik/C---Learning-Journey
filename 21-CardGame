void playerHit(int playerCards[], int *playerCardIndex, int deck[], int *cardIndex){
    playerCards[*playerCardIndex] = deck[*cardIndex];
    (*cardIndex)++;
    (*playerCardIndex)++;

}

void shuffle(int deck[]){
    for(int i = 0; i<52; i++){
        int j = (rand() % 52) ;
        int temporary = deck[i];
        deck[i] = deck[j];
        deck[j] = temporary;
    }
}
void totalPoints(int playerCards[], int playerCardIndex, int *playerSum){
    *playerSum = 0;
    for(int i=0; i<playerCardIndex ;i++){
        (*playerSum) += playerCards[i];
    }
}

void semiRevealCards(int playerCardIndex, int playerCards[]){
    printf("? ");
    for(int i = 1; i<playerCardIndex; i++){
        printf("%d ", playerCards[i]);
    }
    printf("\n");
    printf("\n");
}

void fullyRevealCards(int playerCardIndex, int playerCards[]){
    for(int i = 0; i<playerCardIndex; i++){
        printf("%d ", playerCards[i]);
    }
    printf("\n");
    printf("\n");
}

void checkAce(int playerCardIndex, int playerCards[], int *playerAce){
    for(int i=0; i< playerCardIndex; i++){
        if(playerCards[i] == 11){
            (*playerAce)++;
            playerCards[i] -= 10;
            break;
        }
    }
}
